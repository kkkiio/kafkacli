/// Test functions for FetchResponse

///|
let emptyFetchResponse : Bytes = [0x00, 0x00, 0x00, 0x00]

///|
test "TestEmptyFetchResponse" {
  let response = versioned_decode(emptyFetchResponse, FetchResponse::decode, 0)
  assert_eq(response.blocks.length(), 0)
}

///|
let oneMessageFetchResponse : Bytes = [
  0x00, 0x00, 0x00, 0x01, 0x00, 0x05, 0x74, 0x6f, 0x70, 0x69, 0x63, 0x00, 0x00, 0x00,
  0x01, 0x00, 0x00, 0x00, 0x05, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x10, 0x10, 0x10,
  0x10, 0x00, 0x00, 0x00, 0x1c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x55, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x10, 0x23, 0x96, 0x4a, 0xf7, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0x00,
  0x00, 0x00, 0x02, 0x00, 0xee,
]

///|
let overflowMessageFetchResponse : Bytes = [
  0x00, 0x00, 0x00, 0x01, 0x00, 0x05, 0x74, 0x6f, 0x70, 0x69, 0x63, 0x00, 0x00, 0x00,
  0x01, 0x00, 0x00, 0x00, 0x05, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x10, 0x10, 0x10,
  0x10, 0x00, 0x00, 0x00, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, 0x55, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x10, 0x23, 0x96, 0x4a, 0xf7, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0x00,
  0x00, 0x00, 0x02, 0x00, 0xee, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00,
  0x00, 0x00, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
]

///|
test "TestOneMessageFetchResponse" {
  let response = versioned_decode(
    oneMessageFetchResponse,
    FetchResponse::decode,
    0,
  )
  assert_eq(response.blocks.length(), 1)
  assert_eq(response.blocks["topic"].length(), 1)
  guard response.get_block("topic", 5) is Some(block)
  assert_eq(block.error, 1)
  assert_eq(block.high_watermark_offset, 0x10101010)
  assert_eq(block.records.length(), 28)
}

///|
test "TestOverflowMessageFetchResponse" {
  let response = versioned_decode(
    overflowMessageFetchResponse,
    FetchResponse::decode,
    0,
  )
  assert_eq(response.blocks.length(), 1)
  guard response.get_block("topic", 5) is Some(block)
  assert_eq(block.error, 1)
  assert_eq(block.high_watermark_offset, 0x10101010)
  assert_eq(block.records.length(), 0x30)
}

