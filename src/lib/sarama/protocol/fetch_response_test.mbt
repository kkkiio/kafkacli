let preferredReplicaFetchResponseV11 : Bytes = [
  0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0xac, 0x00, 0x00, 0x00, 0x01,
  0x00, 0x05, 0x74, 0x6f, 0x70, 0x69, 0x63, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,
  0x05, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x10, 0x10, 0x10, 0x10, 0x00, 0x00, 0x00,
  0x00, 0x10, 0x10, 0x10, 0x09, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01, 0x01, 0x01, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x1c, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x55, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x23, 0x96, 0x4a, 0xf7, 0x00,
  0x00, 0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x02, 0x00, 0xee,
]

///|
test "TestPreferredReplicaFetchResponseV11" {
  let response = versioned_decode(
    preferredReplicaFetchResponseV11,
    FetchResponse::decode,
    11,
  )
  assert_eq(response.error_code, 0x0002)
  assert_eq(response.session_id, 0x000000AC)
  match response.get_block("topic", 5) {
    Some(block) => {
      assert_eq(block.error, 1)
      assert_eq(block.high_watermark_offset, 0x10101010)
      assert_eq(block.last_stable_offset, 0x10101009)
      assert_eq(block.log_start_offset, 0x01010101)
      assert_eq(block.preferred_read_replica, 0x0003)
    }
    None => panic()
  }
}

///|
test "TestEmptyRecordsFetchResponseV11" {
  let response = versioned_decode(
    emptyRecordsFetchResponseV11,
    FetchResponse::decode,
    11,
  )
  assert_eq(response.blocks.length(), 1)
  guard response.get_block("topic", 5) is Some(block)
  assert_eq(block.error, 0)
  assert_eq(block.high_watermark_offset, 0x10101010)
  assert_eq(block.records.length(), 0x3d)
  let size_index = block.records.length() - 4
  assert_eq(block.records[size_index], 0)
  assert_eq(block.records[size_index + 1], 0)
  assert_eq(block.records[size_index + 2], 0)
  assert_eq(block.records[size_index + 3], 0)
}

///|
test "TestFetchResponseMultipleTopics" {
  // Test multiple topics and partitions encoding/decoding
  let response = FetchResponse::new()

  // Create blocks directly and add them to the response
  let block1 = FetchResponseBlock::{
    version: response.version,
    error: 0,
    high_watermark_offset: 1000,
    last_stable_offset: 0,
    log_start_offset: 0,
    aborted_transactions: [],
    preferred_read_replica: -1,
    records: [0x01, 0x02, 0x03],
  }
  let block2 = FetchResponseBlock::{
    version: response.version,
    error: 0,
    high_watermark_offset: 2000,
    last_stable_offset: 0,
    log_start_offset: 0,
    aborted_transactions: [],
    preferred_read_replica: -1,
    records: [0x04, 0x05, 0x06],
  }
  let block3 = FetchResponseBlock::{
    version: response.version,
    error: 0,
    high_watermark_offset: 3000,
    last_stable_offset: 0,
    log_start_offset: 0,
    aborted_transactions: [],
    preferred_read_replica: -1,
    records: [0x07, 0x08, 0x09],
  }

  // Add blocks to response
  response.blocks["topic1"] = Map::from_array([(0, block1), (1, block2)])
  response.blocks["topic2"] = Map::from_array([(0, block3)])
  let encoded = encode(response)

  // Test decoding
  let original_version = response.version
  let decoded = decode(encoded, fn(pd) {
    FetchResponse::decode(pd, original_version)
  })
  assert_eq(decoded.blocks.length(), 2)
  assert_eq(decoded.blocks["topic1"].length(), 2)
  assert_eq(decoded.blocks["topic2"].length(), 1)

  // Verify blocks
  match decoded.get_block("topic1", 0) {
    Some(topic1_part0) => {
      assert_eq(topic1_part0.high_watermark_offset, 1000)
      assert_eq(topic1_part0.records, [0x01, 0x02, 0x03])
    }
    None => panic()
  }
}

///|
test "TestFetchResponseAddError" {
  let response = FetchResponse::new()

  // Add error for specific topic/partition
  response.add_error("test_topic", 42, 5) // Error code 5
  assert_eq(response.blocks.length(), 1)
  match response.get_block("test_topic", 42) {
    Some(block) => assert_eq(block.error, 5)
    None => panic()
  }
}
